# Personal OS: Umgebungsvariablen (Vercel → Project → Settings → Environment Variables)
# Lokal: Datei .env.local anlegen. Ohne Werte startet `npm run dev` im Demo-Modus (Passwort "dev").
# Preview-Deployments: nur DATA_SOURCE=mock + SESSION_SECRET + AUTH_PASSWORD_HASH, keine echten Tokens.

# Datenquelle: notion (Produktion) oder mock (Demo-Daten aus dem Design)
DATA_SOURCE=mock
APP_TIMEZONE=Europe/Berlin
OWNER_NAME=Daniel

# Login (Pflicht in Production)
# SESSION_SECRET: mindestens 32 Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=
# Erhöhen = auf allen Geräten abmelden
SESSION_VERSION=1
# Erzeugen mit `npm run hash-password` (Format scrypt$...)
AUTH_PASSWORD_HASH=

# Notion: eigene Integration "Personal OS Web", nur TODOS, Goals, Digest Archive, Agent Log freigeben
NOTION_TOKEN=
NOTION_TODOS_DS_ID=b8065b38-5580-43fc-b022-e8708fc1b680
NOTION_GOALS_DS_ID=467d56b3-cf05-429b-a3dd-08d47c443b7b

# n8n Quick Capture (D_todo_capture /add). URL steht im Webhook-Node und ist geheim.
N8N_CAPTURE_URL=
# Gleicher Wert wie das n8n Header-Auth-Credential (Header X-Personal-OS-Key), sobald F2 aktiv ist
N8N_WEBHOOK_KEY=

# ElevenLabs: API-Key nur serverseitig, für Conversation-Tokens
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_2601m4p82ey6ew8bnejvezdmrt9x

# Siri/Mac-Kurzbefehle: SHA-256-Hashes der Geräte-Tokens, komma-getrennt (`npm run capture-token iphone`)
CAPTURE_TOKENS=
# Optional (F5): Secret für n8n → /api/hooks/revalidate
REVALIDATE_SECRET=
